#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

BASE="/usr/local/bin/irangate-backup-v2-export.py"

LOG="$(mktemp)"
TMP=""
NEW_ARCHIVE=""

cleanup() {
    rm -f "$LOG" "$NEW_ARCHIVE" 2>/dev/null || true

    if [[ -n "$TMP" ]]; then
        rm -rf "$TMP" 2>/dev/null || true
    fi
}

trap cleanup EXIT

[[ -x "$BASE" ]] || {
    echo "Backup core missing: $BASE" >&2
    exit 1
}

set +e
"$BASE" "$@" >"$LOG" 2>&1
RC=$?
set -e

cat "$LOG" >&2

[[ "$RC" -eq 0 ]] || exit "$RC"

ARCHIVE="$(
    grep -Eo \
        '/[^[:space:]]+irangate-backup-v2-[^[:space:]]+\.tar\.gz' \
        "$LOG" |
    tail -1 || true
)"

if [[ -z "$ARCHIVE" || ! -f "$ARCHIVE" ]]; then
    ARCHIVE="$(
        find /opt/irangate/backups/v2 /root \
            -maxdepth 5 \
            -type f \
            -name 'irangate-backup-v2-*.tar.gz' \
            -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        head -1 |
        cut -d' ' -f2-
    )"
fi

[[ -n "$ARCHIVE" && -f "$ARCHIVE" ]] || {
    echo "Backup archive not found" >&2
    exit 1
}

TMP="$(mktemp -d)"

tar -xzf "$ARCHIVE" -C "$TMP"

mkdir -p "$TMP/extras/runtime"

copy_item() {
    local src="$1"
    local dst="$TMP/extras/runtime$src"

    if [[ -e "$src" ]]; then
        mkdir -p "$(dirname "$dst")"
        cp -a "$src" "$dst"
        echo "[backup-extras] added $src" >&2
    fi
}

# IKEv2 / IPSec
# Only IranGate-owned strongSwan files are archived.
# Package-managed defaults are intentionally excluded.
copy_item /etc/swanctl/conf.d/irangate-ikev2-mschapv2.conf
copy_item /etc/swanctl/conf.d/irangate-ikev2-users.conf
copy_item /etc/swanctl/private/irangate-ca-key.pem
copy_item /etc/swanctl/private/irangate-server-key.pem
copy_item /etc/swanctl/x509ca/irangate-ca-cert.pem
copy_item /etc/swanctl/x509/irangate-server-cert.pem
copy_item /etc/sysctl.d/99-irangate-ikev2.conf
copy_item /opt/irangate/ikev2
copy_item /opt/irangate/traffic/ikev2_current_stats.json
copy_item /opt/irangate/traffic/ikev2_last_seen.json
copy_item /opt/irangate/traffic/global_usage_totals.json
copy_item /opt/irangate/webpanel/server.json
copy_item /usr/local/sbin/irangate-ikev2
copy_item /usr/local/sbin/irangate-ikev2-stats-snapshot
copy_item /usr/local/sbin/irangate-ikev2-firewall.sh
copy_item /etc/systemd/system/irangate-ikev2-firewall.service
copy_item /etc/systemd/system/irangate-ikev2-stats.service
copy_item /etc/systemd/system/irangate-ikev2-stats.timer

# Outbound / Routing
copy_item /opt/irangate/routing
copy_item /etc/sing-box/irangate-routing.json
copy_item /usr/local/bin/irangate-routing
copy_item /etc/systemd/system/irangate-routing.service
copy_item /etc/systemd/system/irangate-routing-rules.service

# Panel proxy
copy_item /opt/irangate/panel-proxy.env
copy_item /etc/systemd/system/irangate-webpanel.service.d/proxy.conf

cat >"$TMP/extras/runtime/MANIFEST.txt" <<EOF
created_at=$(date -u +%FT%TZ)
hostname=$(hostname)
contains=ikev2
contains=outbound-routing
contains=panel-proxy
integrity=sha256
EOF

(
    cd "$TMP/extras/runtime"

    find .         -type f         ! -name SHA256SUMS         -print0 |
    sort -z |
    xargs -0 -r sha256sum         >SHA256SUMS
)

chmod 0600     "$TMP/extras/runtime/SHA256SUMS"

chmod 0600 \
    "$TMP/extras/runtime/opt/irangate/ikev2/users.tsv" \
    2>/dev/null || true

find "$TMP/extras/runtime/etc/swanctl/private" \
    -type f \
    -exec chmod 0600 {} \; \
    2>/dev/null || true

NEW_ARCHIVE="${ARCHIVE}.tmp.$$"

tar -C "$TMP" \
    -czf "$NEW_ARCHIVE" \
    .

chmod 0600 "$NEW_ARCHIVE"

mv -f "$NEW_ARCHIVE" "$ARCHIVE"

chmod 0600 "$ARCHIVE"
NEW_ARCHIVE=""

echo "[backup-extras] archive repacked successfully ✅" >&2

# stdout must contain only the archive path.
echo "$ARCHIVE"

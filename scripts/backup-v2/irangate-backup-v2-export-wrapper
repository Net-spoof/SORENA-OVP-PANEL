#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# IRANGATE_BACKUP_SINGLE_PASS_V2_TIMEOUT
BASE="/usr/local/bin/irangate-backup-v2-export.py"
LOCK_FILE="/run/irangate-backup-v2.lock"
STDOUT_FILE="$(mktemp)"

cleanup() {
    rm -f "$STDOUT_FILE" 2>/dev/null || true
}

trap cleanup EXIT

[[ -x "$BASE" ]] || {
    echo "Backup core missing: $BASE" >&2
    exit 1
}

# Panel/manual/Telegram backups all use this wrapper.
# Prevent overlapping archive creation.
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"

    if ! flock -n 9; then
        echo             "Another IranGate backup is already running"             >&2

        exit 75
    fi
fi

# Lower CPU and disk scheduling priority so active VPN traffic remains more
# important than backup compression. Also enforce a hard upper bound so a
# stalled node snapshot can never hold the global backup lock forever.
BACKUP_TIMEOUT="${IRANGATE_BACKUP_TIMEOUT:-25m}"

run_exporter() {
    if command -v ionice >/dev/null 2>&1; then
        ionice -c2 -n7 nice -n 10 "$BASE" "$@"
    else
        nice -n 10 "$BASE" "$@"
    fi
}

set +e
if command -v timeout >/dev/null 2>&1; then
    timeout         --signal=TERM         --kill-after=30s         "$BACKUP_TIMEOUT"         bash -c '
            BASE="$1"
            shift
            if command -v ionice >/dev/null 2>&1; then
                exec ionice -c2 -n7 nice -n 10 "$BASE" "$@"
            else
                exec nice -n 10 "$BASE" "$@"
            fi
        ' _ "$BASE" "$@"         >"$STDOUT_FILE"
    RC=$?
else
    run_exporter "$@" >"$STDOUT_FILE"
    RC=$?
fi
set -e

if [[ "$RC" -eq 124 || "$RC" -eq 137 ]]; then
    echo "IranGate Backup v2 timed out after $BACKUP_TIMEOUT" >&2
    exit 124
fi

if [[ "$RC" -ne 0 ]]; then
    exit "$RC"
fi

ARCHIVE="$(
    awk '
        NF {
            line = $0
        }

        END {
            print line
        }
    ' "$STDOUT_FILE" |
    tr -d '\r'
)"

[[ -n "$ARCHIVE" && -s "$ARCHIVE" ]] || {
    echo "Backup archive was not produced" >&2
    exit 1
}

case "$ARCHIVE" in
    /opt/irangate/backups/v2/irangate-backup-v2-*.tar.gz)
        ;;
    *)
        echo             "Unexpected backup archive path: $ARCHIVE"             >&2

        exit 1
        ;;
esac

# stdout must contain only the archive path.
printf '%s\n' "$ARCHIVE"

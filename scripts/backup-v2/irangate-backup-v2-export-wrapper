#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# IRANGATE_BACKUP_SINGLE_PASS_V1
BASE="/usr/local/bin/irangate-backup-v2-export.py"
LOCK_FILE="/run/irangate-backup-v2.lock"
STDOUT_FILE="$(mktemp)"

cleanup() {
    rm -f "$STDOUT_FILE" 2>/dev/null || true
}

trap cleanup EXIT

[[ -x "$BASE" ]] || {
    echo "Backup core missing: $BASE" >&2
    exit 1
}

# Panel/manual/Telegram backups all use this wrapper.
# Prevent overlapping archive creation.
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"

    if ! flock -n 9; then
        echo             "Another IranGate backup is already running"             >&2

        exit 75
    fi
fi

# Lower CPU and disk scheduling priority so active VPN
# traffic remains more important than backup compression.
if command -v ionice >/dev/null 2>&1; then
    ionice -c2 -n7         nice -n 10         "$BASE" "$@"         >"$STDOUT_FILE"
else
    nice -n 10         "$BASE" "$@"         >"$STDOUT_FILE"
fi

ARCHIVE="$(
    awk '
        NF {
            line = $0
        }

        END {
            print line
        }
    ' "$STDOUT_FILE" |
    tr -d '\r'
)"

[[ -n "$ARCHIVE" && -s "$ARCHIVE" ]] || {
    echo "Backup archive was not produced" >&2
    exit 1
}

case "$ARCHIVE" in
    /opt/irangate/backups/v2/irangate-backup-v2-*.tar.gz)
        ;;
    *)
        echo             "Unexpected backup archive path: $ARCHIVE"             >&2

        exit 1
        ;;
esac

# stdout must contain only the archive path.
printf '%s\n' "$ARCHIVE"

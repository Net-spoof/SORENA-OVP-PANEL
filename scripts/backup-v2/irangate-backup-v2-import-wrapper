#!/usr/bin/env bash
set -Eeuo pipefail

BASE="/usr/local/bin/irangate-backup-v2-import.py"

ARCHIVE=""
VALIDATE_ONLY=0
CORE_LOG="$(mktemp)"
TMP=""

cleanup() {
    rm -f "$CORE_LOG" 2>/dev/null || true

    if [[ -n "$TMP" ]]; then
        rm -rf "$TMP" 2>/dev/null || true
    fi
}

trap cleanup EXIT

verify_runtime_integrity() {
    local root="$1"
    local checksums="$root/SHA256SUMS"

    if [[ ! -d "$root" ]]; then
        return 0
    fi

    if [[ ! -f "$checksums" ]]; then
        echo \
            "[backup-extras] legacy extras archive: SHA256SUMS missing" \
            >&2

        return 0
    fi

    if ! (
        cd "$root"

        sha256sum \
            --check \
            --strict \
            SHA256SUMS
    )
    then
        echo \
            "[backup-extras] runtime extras integrity check failed" \
            >&2

        return 1
    fi

    echo \
        "[backup-extras] runtime extras integrity verified ✅" \
        >&2
}

for arg in "$@"; do
    case "$arg" in
        --validate-only|--dry-run|validate-only)
            VALIDATE_ONLY=1
            ;;
        *.tar.gz|*.tgz)
            [[ -f "$arg" ]] && ARCHIVE="$arg"
            ;;
    esac
done

[[ -x "$BASE" ]] || {
    echo "Backup core missing: $BASE" >&2
    exit 1
}

# Validate the archive AND its IKEv2 canonical store before PostgreSQL,
# clients, timers or VPN state can be modified by the core importer.
# The core alone does not validate runtime extras (they are restored below).
if [[ -n "$ARCHIVE" ]]; then
    "$BASE" --validate-only "$ARCHIVE" >/dev/null || {
        echo "[backup-extras] core archive validation failed before restore" >&2
        exit 1
    }
    GUARD="/usr/local/sbin/irangate-ikev2-backup-guard"
    if [[ ! -f "$GUARD" ]]; then
        echo "[backup-extras] credential guard missing; no restore performed" >&2
        exit 1
    fi
    python3 - "$ARCHIVE" "$GUARD" <<'PY_GUARD'
import pathlib
import subprocess
import sys
import tarfile
import tempfile

archive, guard = sys.argv[1:]
wanted = {
    "etc/swanctl/conf.d/irangate-ikev2-mschapv2.conf",
    "etc/swanctl/conf.d/irangate-ikev2-users.conf",
    "opt/irangate/ikev2/users.tsv",
}
with tempfile.TemporaryDirectory(prefix="ikev2-archive-guard-") as tmp:
    seen = set()
    with tarfile.open(archive, "r:*") as tar:
        for member in tar:
            path = member.name.removeprefix("./")
            parts = path.split("/")
            if len(parts) < 3 or parts[0:2] not in (
                ["extras", "runtime"], ["extras", "ikev2"]
            ):
                continue
            rel = "/".join(parts[2:])
            if rel not in wanted:
                continue
            if (rel in seen or not member.isfile() or
                    member.size > 16 * 1024 * 1024):
                raise SystemExit("IKEv2 backup invalid/duplicate credential entry")
            seen.add(rel)
            fileobj = tar.extractfile(member)
            if fileobj is None:
                raise SystemExit("IKEv2 backup credential unreadable")
            destination = pathlib.Path(tmp, rel)
            destination.parent.mkdir(parents=True, exist_ok=True)
            with destination.open("wb") as output:
                output.write(fileobj.read(16 * 1024 * 1024 + 1))
    if not seen and pathlib.Path(
        "/etc/swanctl/conf.d/irangate-ikev2-mschapv2.conf"
    ).is_file():
        raise SystemExit("Backup lacks IKEv2 credentials; refusing unsafe restore")
    result = subprocess.run(
        [sys.executable, guard, "--snapshot", tmp], check=False
    )
    raise SystemExit(result.returncode)
PY_GUARD
fi

set +e
"$BASE" "$@" >"$CORE_LOG" 2>&1
RC=$?
set -e

cat "$CORE_LOG"

[[ "$RC" -eq 0 ]] || exit "$RC"

if [[ -z "$ARCHIVE" ||
      ! -f "$ARCHIVE" ]]
then
    exit 0
fi

TMP="$(mktemp -d)"

python3 - "$ARCHIVE" "$TMP" <<'PY_EXTRACT'
import os
import shutil
import sys
import tarfile
from pathlib import Path, PurePosixPath

archive = Path(sys.argv[1])
root = Path(sys.argv[2]).resolve()

allowed = (
    "extras/runtime/",
    "extras/ikev2/",
)

with tarfile.open(archive, "r:*") as tar:
    for member in tar.getmembers():
        raw = str(member.name or "").replace("\\", "/")

        while raw.startswith("./"):
            raw = raw[2:]

        path = PurePosixPath(raw)

        if path.is_absolute() or ".." in path.parts:
            continue

        if not any(raw.startswith(prefix) for prefix in allowed):
            continue

        if member.issym() or member.islnk():
            continue

        destination = (root / raw).resolve()

        if root not in destination.parents and destination != root:
            continue

        if member.isdir():
            destination.mkdir(parents=True, exist_ok=True)
            continue

        if not member.isfile():
            continue

        destination.parent.mkdir(parents=True, exist_ok=True)

        source = tar.extractfile(member)
        if source is None:
            continue

        with destination.open("wb") as output:
            shutil.copyfileobj(source, output)

        os.chmod(destination, member.mode & 0o777)
PY_EXTRACT

ROOT=""

for candidate in \
    "$TMP/extras/runtime" \
    "$TMP/extras/ikev2"
do
    if [[ -d "$candidate" ]]; then
        ROOT="$candidate"
        break
    fi
done

[[ -n "$ROOT" ]] || exit 0

verify_runtime_integrity "$ROOT"

if [[ "$VALIDATE_ONLY" -eq 1 ]]; then
    echo         "[backup-extras] validate-only integrity check complete ✅"         >&2

    exit 0
fi

restore_item() {
    local rel="$1"
    local src="$ROOT$rel"
    local dst="$rel"

    if [[ ! -e "$src" ]]; then
        return
    fi

    mkdir -p "$(dirname "$dst")"
    rm -rf "$dst"
    cp -a "$src" "$dst"

    echo "[backup-extras] restored $dst" >&2
}

# IKEv2
# Serialize restore with password rotation; never replace the whole IKEv2
# directory (that would swap the flock inode and permit split-brain writes).
if [[ -f "$ROOT/opt/irangate/ikev2/users.tsv" ]]; then
    [[ -x /usr/local/sbin/irangate-ikev2 ]] || {
        echo "[backup-extras] IKEv2 manager missing; refusing unsafe restore" >&2
        exit 1
    }
    mkdir -p -m 0700 /opt/irangate/ikev2
    exec 8>>/opt/irangate/ikev2/.credentials.lock
    flock -x -w 60 8 || {
        echo "[backup-extras] IKEv2 credential lock timeout" >&2
        exit 1
    }
fi
# Restore only IranGate-owned strongSwan files.
restore_item /etc/swanctl/conf.d/irangate-ikev2-mschapv2.conf
# Generated from users.tsv by irangate-ikev2 reload, NEVER restored as independent secret source.
restore_item /etc/swanctl/private/irangate-ca-key.pem
restore_item /etc/swanctl/private/irangate-server-key.pem
restore_item /etc/swanctl/x509ca/irangate-ca-cert.pem
restore_item /etc/swanctl/x509/irangate-server-cert.pem
restore_item /etc/sysctl.d/99-irangate-ikev2.conf
restore_item /opt/irangate/ikev2/users.tsv
restore_item /opt/irangate/traffic/ikev2_current_stats.json
restore_item /opt/irangate/traffic/ikev2_last_seen.json
restore_item /opt/irangate/traffic/global_usage_totals.json
restore_item /opt/irangate/webpanel/server.json
# Preserve installed credential manager; old backups may contain an unsafe older version.
restore_item /usr/local/sbin/irangate-ikev2-stats-snapshot
restore_item /usr/local/sbin/irangate-ikev2-firewall.sh
restore_item /etc/systemd/system/irangate-ikev2-firewall.service
restore_item /etc/systemd/system/irangate-ikev2-stats.service
restore_item /etc/systemd/system/irangate-ikev2-stats.timer

# Routing
restore_item /opt/irangate/routing
restore_item /etc/sing-box/irangate-routing.json
restore_item /usr/local/bin/irangate-routing
restore_item /usr/local/sbin/irangate-openvpn-port-locations
restore_item /etc/systemd/system/irangate-routing.service
restore_item /etc/systemd/system/irangate-routing-rules.service
restore_item /etc/systemd/system/irangate-openvpn-port-locations.service

# Proxy
restore_item /opt/irangate/panel-proxy.env
restore_item /etc/systemd/system/irangate-webpanel.service.d/proxy.conf

chmod 0755 \
    /usr/local/sbin/irangate-ikev2 \
    /usr/local/sbin/irangate-ikev2-stats-snapshot \
    /usr/local/sbin/irangate-ikev2-firewall.sh \
    /usr/local/bin/irangate-routing \
    /usr/local/sbin/irangate-openvpn-port-locations \
    2>/dev/null || true

chmod 0600 \
    /opt/irangate/ikev2/users.tsv \
    2>/dev/null || true

find /etc/swanctl/private \
    -type f \
    -exec chmod 0600 {} \; \
    2>/dev/null || true

systemctl daemon-reload || true
sysctl --system >/dev/null 2>&1 || true

# IRANGATE_OPENVPN_PORT_LOCATION_WRAPPER_STAGE6B
if [[ -x /usr/local/sbin/irangate-openvpn-port-locations &&
      -f /opt/irangate/routing/openvpn-port-locations.json ]]
then
    echo         "[backup-extras] reconciling OpenVPN port locations"         >&2

    if ! /usr/local/sbin/irangate-openvpn-port-locations apply         >&2
    then
        echo             "[backup-extras] OpenVPN port-location reconcile failed ❌"             >&2
        exit 1
    fi
fi

if [[ -s /opt/irangate/ikev2/users.tsv && ! -x /usr/local/sbin/irangate-ikev2 ]]; then
    echo "[backup-extras] IKEv2 credential manager missing: refusing incomplete restore" >&2
    exit 1
fi

if [[ -x /usr/local/sbin/irangate-ikev2 ]]; then
    systemctl enable --now strongswan \
        >/dev/null 2>&1 || true

    systemctl enable --now irangate-ikev2-firewall.service \
        >/dev/null 2>&1 || true

    systemctl enable --now irangate-ikev2-stats.timer \
        >/dev/null 2>&1 || true

    # Fail loudly; never report restore success with unavailable or stale EAP.
    /usr/local/sbin/irangate-ikev2 reload \
        >/dev/null ||
        { echo "[backup-extras] IKEv2 EAP reload FAILED" >&2; exit 1; }
    /usr/bin/python3 /usr/local/sbin/irangate-ikev2-backup-guard --live ||
        { echo "[backup-extras] IKEv2 live credentials diverged" >&2; exit 1; }
fi
if [[ -f "$ROOT/opt/irangate/ikev2/users.tsv" ]]; then
    flock -u 8
    exec 8>&-
fi

if [[ -x /usr/local/bin/irangate-routing &&
      -x "$(command -v sing-box 2>/dev/null || true)" ]]
then
    /usr/local/bin/irangate-routing \
        generate-engine \
        --write \
        --check \
        >/dev/null 2>&1 || true

    if systemctl is-enabled --quiet irangate-routing.service ||
       systemctl is-active --quiet irangate-routing.service
    then
        systemctl restart irangate-routing.service \
            >/dev/null 2>&1 || true
    fi
fi

if [[ -f /opt/irangate/panel-proxy.env ||
      -f /etc/systemd/system/irangate-webpanel.service.d/proxy.conf ]]
then
    printf '%s\n' \
        'restart irangate-webpanel.service to apply restored proxy settings' \
        >/opt/irangate/panel-proxy-restart-required
fi

echo "[backup-extras] runtime extras restored ✅" >&2

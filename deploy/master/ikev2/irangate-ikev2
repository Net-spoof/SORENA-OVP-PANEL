#!/usr/bin/env bash

set -u
umask 077

CONN_NAME="irangate-ikev2-mschapv2"


preferred_host() {
  python3 - <<'PY_HOST'
import json
import re
import subprocess
from pathlib import Path
from urllib.parse import urlparse

paths = [
    Path("/opt/irangate/webpanel/server.json"),
    Path("/opt/irangate/server_config.json"),
    Path("/opt/irangate/database/settings.json"),
]

keys = (
    "ikev2_server_host",
    "server_domain",
    "server_ip",
    "public_ip",
)

def normalize(value):
    value = str(value or "").strip()

    if not value:
        return ""

    if "://" in value:
        parsed = urlparse(value)
        value = parsed.hostname or ""

    value = value.strip().strip("[]")

    if value.count(":") == 1:
        host, port = value.rsplit(":", 1)
        if port.isdigit():
            value = host

    if not re.fullmatch(r"[A-Za-z0-9._:-]+", value):
        return ""

    return value

for path in paths:
    try:
        data = json.loads(path.read_text())
    except Exception:
        continue

    if not isinstance(data, dict):
        continue

    for key in keys:
        value = normalize(data.get(key))
        if value:
            print(value)
            raise SystemExit

try:
    output = subprocess.check_output(
        ["ip", "-4", "route", "get", "1.1.1.1"],
        text=True,
        stderr=subprocess.DEVNULL,
    )

    fields = output.split()

    if "src" in fields:
        value = normalize(fields[fields.index("src") + 1])
        if value:
            print(value)
            raise SystemExit
except Exception:
    pass

print("127.0.0.1")
PY_HOST
}


BASE_DIR="/opt/irangate/ikev2"
USERS_DB="$BASE_DIR/users.tsv"
USERS_CONF="/etc/swanctl/conf.d/irangate-ikev2-users.conf"

mkdir -p "$BASE_DIR"
touch "$USERS_DB"
chmod 600 "$USERS_DB"

die() {
  echo "ERROR: $*" >&2
  exit 1
}

valid_user() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]{3,64}$ ]]
}

valid_pass() {
  [[ "$1" =~ ^[a-zA-Z0-9._@%+=:-]{8,128}$ ]]
}

gen_pass() {
  openssl rand -base64 24 | tr -d '=+/' | cut -c1-22
}

credential_tx_exit() {
  local rc="$1"
  trap - EXIT
  if [[ "$rc" -ne 0 && -n "${CRED_TX_DIR:-}" ]]; then
    cp -p "$CRED_TX_DIR/users.tsv" "$USERS_DB" || true
    if [[ -f "$CRED_TX_DIR/users.conf" ]]; then
      cp -p "$CRED_TX_DIR/users.conf" "$USERS_CONF" || true
    else
      rm -f "$USERS_CONF"
    fi
    swanctl --load-all --noprompt >/dev/null 2>&1 || true
    echo "ERROR: IKEv2 credential operation rolled back" >&2
  fi
  if [[ -n "${CRED_TX_DIR:-}" ]]; then
    rm -rf -- "$CRED_TX_DIR"
  fi
}

begin_credential_transaction() {
  command -v flock >/dev/null 2>&1 || die "flock is required"
  exec 9>"$BASE_DIR/.credentials.lock"
  flock -x -w 30 9 || die "another IKEv2 credential operation is running"
  CRED_TX_DIR="$(mktemp -d "$BASE_DIR/.credentials-tx.XXXXXXXX")" || die "cannot create credential safety directory"
  chmod 0700 "$CRED_TX_DIR"
  cp -p "$USERS_DB" "$CRED_TX_DIR/users.tsv" || die "cannot back up IKEv2 users"
  if [[ -e "$USERS_CONF" ]]; then
    cp -p "$USERS_CONF" "$CRED_TX_DIR/users.conf" || die "cannot back up StrongSwan credentials"
  fi
  trap 'credential_tx_exit "$?"' EXIT
}

render_users_conf() {
  local tmp
  tmp="$(mktemp "${USERS_CONF}.tmp.XXXXXXXX")" || return 1
  chmod 0600 "$tmp" || { rm -f "$tmp"; return 1; }
  printf 'secrets {\n' > "$tmp"
  if ! awk -F'\t' '
    NF != 4 { print "ERROR: invalid IKEv2 TSV row" > "/dev/stderr"; exit 1 }
    {
      user=$1
      if (user == "" || seen[user]++) {
        print "ERROR: empty or duplicate IKEv2 user" > "/dev/stderr"
        exit 1
      }
      if ($4 != "active" && $4 != "blocked") {
        print "ERROR: invalid IKEv2 status" > "/dev/stderr"
        exit 1
      }
    }
    $4=="active" {
      pass=$2
      if (pass == "") {
        print "ERROR: missing IKEv2 password" > "/dev/stderr"
        exit 1
      }
      key=user
      gsub(/[^a-zA-Z0-9_-]/, "_", key)
      if (labels[key]++) {
        print "ERROR: conflicting normalized IKEv2 account labels" > "/dev/stderr"
        exit 1
      }
      print "    eap-" key " {"
      print "        id = \"" user "\""
      print "        secret = \"" pass "\""
      print "    }"
    }
  ' "$USERS_DB" >> "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  printf '}\n' >> "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f -- "$tmp" "$USERS_CONF"
}

reload_swanctl() {
  if ! swanctl --load-all --noprompt >/dev/null 2>&1; then
    echo "ERROR: StrongSwan credential reload failed" >&2
    return 1
  fi
}

terminate_user() {
  local target="${1:-}"
  [ -n "$target" ] || die "usage: irangate-ikev2 terminate USER"
  valid_user "$target" || die "invalid username"

  local out
  out="$(swanctl --list-sas 2>/dev/null || true)"

  local ike_id=""
  local found=0

  while IFS= read -r line; do
    if [[ "$line" =~ ^[^[:space:]].*#([0-9]+), ]]; then
      ike_id="${BASH_REMATCH[1]}"
    fi

    if [[ "$line" == *"EAP: '$target'"* ]]; then
      found=1
      echo "terminating user=$target ike_id=$ike_id"
      swanctl --terminate --ike-id "$ike_id" 2>&1 || true
    fi
  done <<< "$out"

  if [ "$found" -eq 0 ]; then
    echo "no active session for $target"
  fi
}

set_status() {
  local user="${1:-}"
  local status="${2:-}"

  [ -n "$user" ] || die "usage: irangate-ikev2 status USER active|blocked"
  valid_user "$user" || die "invalid username"

  [[ "$status" == "active" || "$status" == "blocked" ]] || die "invalid status"

  local row pass created old_status
  row="$(awk -F'\t' -v u="$user" '$1==u {print; exit}' "$USERS_DB")"

  if [ -z "$row" ]; then
    echo "IKEv2 user not found; nothing to change: $user"
    return 0
  fi

  pass="$(echo "$row" | awk -F'\t' '{print $2}')"
  created="$(echo "$row" | awk -F'\t' '{print $3}')"
  old_status="$(echo "$row" | awk -F'\t' '{print $4}')"

  awk -F'\t' -v u="$user" '$1 != u' "$USERS_DB" > "$USERS_DB.tmp" || die "unable to update IKEv2 users"
  printf "%s\t%s\t%s\t%s\n" "$user" "$pass" "$created" "$status" >> "$USERS_DB.tmp" || die "unable to append IKEv2 user"
  chmod 600 "$USERS_DB.tmp"
  mv -f "$USERS_DB.tmp" "$USERS_DB" || die "unable to commit IKEv2 users"

  render_users_conf || die "IKEv2 credential rendering failed"
  reload_swanctl || die "IKEv2 credential reload failed"

  if [ "$status" = "blocked" ]; then
    terminate_user "$user" >/dev/null 2>&1 || true
  fi

  echo "IKEv2 user status changed ✅ user=$user old=$old_status new=$status"
}

add_user() {
  local user="${1:-}"
  local pass="${2:-}"

  [ -n "$user" ] || die "usage: irangate-ikev2 add USER [PASSWORD]"
  valid_user "$user" || die "invalid username. allowed: a-z A-Z 0-9 . _ - length 3-64"

  if [ -z "$pass" ]; then
    pass="$(gen_pass)"
  fi

  valid_pass "$pass" || die "invalid password. min 8, no spaces or quotes"

  local created
  created="$(awk -F'\t' -v u="$user" '$1==u {print $3; exit}' "$USERS_DB")"
  if [[ -z "$created" ]]; then
    created="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  fi

  awk -F'\t' -v u="$user" '$1 != u' "$USERS_DB" > "$USERS_DB.tmp" || die "unable to update IKEv2 users"
  printf "%s\t%s\t%s\tactive\n" "$user" "$pass" "$created" >> "$USERS_DB.tmp" || die "unable to append IKEv2 user"
  chmod 600 "$USERS_DB.tmp"
  mv -f "$USERS_DB.tmp" "$USERS_DB" || die "unable to commit IKEv2 users"

  render_users_conf || die "IKEv2 credential rendering failed"
  reload_swanctl || die "IKEv2 credential reload failed"

  echo "IKEv2 user created ✅"
  echo
  show_config "$user"
}

delete_user() {
  local user="${1:-}"
  [ -n "$user" ] || die "usage: irangate-ikev2 del USER"
  valid_user "$user" || die "invalid username"

  terminate_user "$user" >/dev/null 2>&1 || true

  awk -F'\t' -v u="$user" '$1 != u' "$USERS_DB" > "$USERS_DB.tmp" || die "unable to update IKEv2 users"
  chmod 600 "$USERS_DB.tmp"
  mv -f "$USERS_DB.tmp" "$USERS_DB" || die "unable to commit IKEv2 users"

  render_users_conf || die "IKEv2 credential rendering failed"
  reload_swanctl || die "IKEv2 credential reload failed"

  echo "IKEv2 user deleted ✅ $user"
}

rotate_user() {
  local user="${1:-}"
  [ -n "$user" ] || die "usage: irangate-ikev2 rotate USER"
  valid_user "$user" || die "invalid username"
  local row
  row="$(awk -F'\t' -v u="$user" '$1==u {print; exit}' "$USERS_DB")"
  [[ -n "$row" ]] || die "cannot rotate missing IKEv2 user"
  [[ "$(printf '%s\n' "$row" | awk -F'\t' '{print $4}')" == "active" ]] ||
    die "cannot rotate blocked IKEv2 user"
  add_user "$user"
}

list_users() {
  echo "===== IKEv2 USERS ====="
  if [ ! -s "$USERS_DB" ]; then
    echo "no users"
    return 0
  fi

  awk -F'\t' 'BEGIN {
    printf "%-24s %-10s %-22s\n", "USERNAME", "STATUS", "CREATED"
  }
  {
    printf "%-24s %-10s %-22s\n", $1, $4, $3
  }' "$USERS_DB"
}

sessions() {
  local out
  out="$(swanctl --list-sas 2>/dev/null || true)"

  if [ -z "$out" ]; then
    echo "no active IKEv2 sessions"
    return 0
  fi

  local ike_id=""

  while IFS= read -r line; do
    if [[ "$line" =~ ^[^[:space:]].*#([0-9]+), ]]; then
      ike_id="${BASH_REMATCH[1]}"
    fi

    if [[ "$line" == *" EAP: '"* ]]; then
      user="${line#*EAP: \'}"
      user="${user%%\'*}"
      ip="${line##*[}"
      ip="${ip%%]*}"
      echo "ike_id=$ike_id user=$user ip=$ip"
    fi

    if [[ "$line" =~ ^[[:space:]]+in[[:space:]] ]]; then
      echo "$line"
    fi

    if [[ "$line" =~ ^[[:space:]]+out[[:space:]] ]]; then
      echo "$line"
    fi
  done <<< "$out"
}

terminate_all() {
  swanctl --terminate --ike "$CONN_NAME" 2>&1 || true
}

show_config() {
  local user="${1:-}"
  [ -n "$user" ] || die "usage: irangate-ikev2 show USER"
  valid_user "$user" || die "invalid username"

  local row pass status
  row="$(awk -F'\t' -v u="$user" '$1==u {print; exit}' "$USERS_DB")"
  [ -n "$row" ] || die "user not found"

  pass="$(echo "$row" | awk -F'\t' '{print $2}')"
  status="$(echo "$row" | awk -F'\t' '{print $4}')"

  local public_host
  public_host="$(preferred_host)"

  # Show credentials even when blocked/expired.
  # Authentication is still disabled because blocked users are not rendered into swanctl secrets.
  echo "Status: $status"

  echo "Type: IKEv2/IPSec MSCHAPv2"
  echo "Server: $public_host"
  echo "IPSec identifier: $public_host"
  echo "CA certificate: Do not validate"
  echo "IPSec server certificate: Received from server"
  echo "Username: $user"
  echo "Password: $pass"
}

case "${1:-}" in
  add|rotate|del|delete|remove|block|unblock|reload)
    begin_credential_transaction
    ;;
esac

case "${1:-}" in
  add)
    add_user "${2:-}" "${3:-}"
    ;;
  rotate)
    rotate_user "${2:-}"
    ;;
  del|delete|remove)
    delete_user "${2:-}"
    ;;
  block)
    set_status "${2:-}" "blocked"
    ;;
  unblock)
    set_status "${2:-}" "active"
    ;;
  list)
    list_users
    ;;
  sessions|online)
    sessions
    ;;
  terminate|kill)
    terminate_user "${2:-}"
    ;;
  terminate-all|kill-all)
    terminate_all
    ;;
  show|config)
    show_config "${2:-}"
    ;;
  reload)
    render_users_conf || die "IKEv2 credential rendering failed"
    reload_swanctl || die "IKEv2 credential reload failed"
    echo "IKEv2 users reloaded ✅"
    ;;
  *)
    cat <<USAGE
IranGate IKEv2 user manager

Usage:
  irangate-ikev2 add USER [PASSWORD]
  irangate-ikev2 rotate USER
  irangate-ikev2 del USER
  irangate-ikev2 block USER
  irangate-ikev2 unblock USER
  irangate-ikev2 list
  irangate-ikev2 sessions
  irangate-ikev2 terminate USER
  irangate-ikev2 terminate-all
  irangate-ikev2 show USER
  irangate-ikev2 reload
USAGE
    ;;
esac
